# Backend - Copia a .env en la raíz del proyecto y rellena los valores

GOOGLE_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434
# RAG más rápido (opcional): keep_alive en segundos para que Ollama no descargue el modelo entre consultas (GPU).
# OLLAMA_EMBED_KEEP_ALIVE=1800
# Modelo de embeddings: nomic-embed-text (por defecto, más rápido) o mxbai-embed-large (mejor calidad).
# Si cambias, reconstruye el índice: python -m app.rag.vector_store rebuild
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
# RAG_EMBED_CACHE_SIZE=200
# RAG_CHUNK_SIZE=650
# RAG_CHUNK_OVERLAP=80

LOGIN_USER=
LOGIN_PASSWORD=
JWT_SECRET_KEY=

# Arize AX (Tracing Projects). Si tu dashboard es EU (app.eu-west-1a.arize.com) → usar endpoint EU
ARIZE_SPACE_ID=
ARIZE_PROJECT_NAME=
ARIZE_API_KEY=
# Endpoint EU (si tu cuenta es US, comenta esta línea para usar otlp.arize.com)
ARIZE_COLLECTOR_ENDPOINT=

# WhatsApp Cloud API (Meta)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# App Secret para validar X-Hub-Signature-256 (recomendado en producción)
WHATSAPP_WEBHOOK_SECRET=
# Opcional (por defecto v21.0)
WHATSAPP_API_VERSION=v21.0

# Stripe Checkout (modo test)
STRIPE_SECRET_KEY=
# Debe incluir {CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/payment/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/payment/cancel
# Opcional (por defecto eur)
STRIPE_CURRENCY=eur
# Firma webhook Stripe (Dashboard/CLI)
STRIPE_WEBHOOK_SECRET=
