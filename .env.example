# Backend - Copia a .env en la raíz del proyecto y rellena los valores

# --- Google AI Studio (Gemini) - obligatorio para los agentes ---
# Crear API key en: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# --- Opcional: protección de la API ---
# API_KEY_SECRET=

# --- Opcional: RAG (Ollama para embeddings) ---
# Solo si Ollama no está en localhost:11434. Por defecto: http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434

# --- Opcional: Login para el chat (frontend) ---
# Usuarios: uno desde env (LOGIN_USER, LOGIN_PASSWORD) y el resto en data/users.json (ver abajo).
# JWT_SECRET_KEY: clave para firmar los tokens (cambiar en producción).
# LOGIN_USER=admin
# LOGIN_PASSWORD=tu_contraseña
# JWT_SECRET_KEY=una-clave-secreta-muy-larga-y-aleatoria
# REGISTER_SECRET: clave para POST /auth/register (por defecto usa API_KEY_SECRET). Cabecera X-Admin-Key.
# USERS_FILE: ruta al JSON de usuarios (por defecto data/users.json).
