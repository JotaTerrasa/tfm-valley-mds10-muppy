# Backend - Copia a .env en la raíz del proyecto y rellena los valores

GOOGLE_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434

LOGIN_USER=
LOGIN_PASSWORD=
JWT_SECRET_KEY=

# Arize AX (Tracing Projects). Si tu dashboard es EU (app.eu-west-1a.arize.com) → usar endpoint EU
ARIZE_SPACE_ID=
ARIZE_PROJECT_NAME=
ARIZE_API_KEY=
# Endpoint EU (si tu cuenta es US, comenta esta línea para usar otlp.arize.com)
ARIZE_COLLECTOR_ENDPOINT=
